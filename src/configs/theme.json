{
  "$schema": "../../schemas/theme.schema.json",
  "palette": {
    "primary": "#0d1f3c",
    "primary-light": "#1e3a5f",
    "primary-dark": "#060f1f",
    "secondary": "#2d5a8e",
    "secondary-light": "#3b6fa8",
    "secondary-dark": "#1e3f63",
    "background": "#ffffff",
    "foreground": "#0d1f3c"
  },
  "neutral": {
    "light": "#f4f6f9",
    "base": "#eef1f5",
    "medium": "#c8d4e0",
    "dark": "#5e6e7e",
    "darker": "#3d4f64"
  },
  "radii": {
    "sm": "2px",
    "md": "3px",
    "lg": "4px",
    "xl": "5px"
  },
  "shadow": {
    "md": "0 1px 2px rgba(6, 15, 31, 0.04), 0 2px 8px rgba(6, 15, 31, 0.06)",
    "lg": "0 4px 16px rgba(13, 31, 60, 0.12), 0 8px 24px rgba(13, 31, 60, 0.06)"
  },
  "typography": {
    "fonts": [
      {
        "role": "body",
        "name": "Lora",
        "provider": "fontsource",
        "weights": [400, 500, 600, 700],
        "styles": ["normal", "italic"],
        "fallback": "serif",
        "display": "optional"
      },
      {
        "role": "heading",
        "name": "NectoMono",
        "provider": "local",
        "weights": [400],
        "styles": ["normal"],
        "fallback": "monospace",
        "display": "optional",
        "src": ["./public/assets/fonts/NectoMono-Regular.woff2"]
      }
    ]
  }
}
